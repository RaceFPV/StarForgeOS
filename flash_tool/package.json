{
  "name": "starforge-flash-tool",
  "version": "1.0.0",
  "description": "StarForge ESP32 Flash Tool - Easy firmware updates for all StarForge boards",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "dist": "electron-builder --mac --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "setup-platformio": "node scripts/setup-platformio.js",
    "prebuild": "npm run setup-platformio"
  },
  "keywords": [
    "ESP32",
    "firmware",
    "flasher",
    "StarForge",
    "FPV"
  ],
  "author": "RaceFPV",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaceFPV/StarForgeOS.git"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "serialport": "^12.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "cli-truncate": "2.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "26.18.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "@serialport/bindings-cpp": true
  },
  "overrides": {
    "@electron/universal": {
      "minimatch": "11.0.9"
    },
    "app-builder-lib": {
      "minimatch": "11.0.9"
    }
  },
  "build": {
    "appId": "io.racefpv.starforge-flash-tool",
    "productName": "StarForge Flash Tool",
    "artifactName": "${productName}_${version}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "artifactName": "StarForge_Flash_Tool_${version}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "StarForge_Flash_Tool_${version}.${ext}"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "resources/bin/",
        "to": "resources/bin/",
        "filter": [
          "esptool-*",
          "platformio-*"
        ]
      },
      {
        "from": "resources/platformio/",
        "to": "resources/platformio/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}
